# ── Phase 1 (local) ──────────────────────────────────────────────
# SQLite file path. Phase 2: replace with Supabase transaction-pool URL.
DATABASE_URL=./data/xportal.db

# Base URL used in magic-link emails.
APP_BASE_URL=http://localhost:3100

# Shared secret for the xPM <-> xPortal bridge (X-XPM-Bridge-Secret header).
XPM_API_BRIDGE_SECRET=dev-local-bridge-secret

# Optional: xPM endpoint to receive outbound approval/revision webhooks.
# Leave empty in Phase 1 to log payloads to the console instead.
XPM_WEBHOOK_URL=

# Email provider: "console" (Phase 1) or "resend" (Phase 2).
EMAIL_PROVIDER=console
RESEND_API_KEY=

# Stripe. Phase 1: leave empty — the webhook route accepts unsigned test
# payloads. Phase 2: set sk_live_/whsec_ values in Vercel env, never in chat.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Phase 2 (Vercel + Supabase) — leave empty locally ────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
